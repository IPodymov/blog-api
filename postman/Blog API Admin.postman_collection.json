  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Вход глобального администратора",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Глобальный администратор не принадлежит ни одному сайту; X-Site-Key не нужен. Токен живёт 12 часов, refresh нет — CRM входит заново. Первого администратора создаёт оператор командой `go run ./cmd/admin create -email ...`. Rate limit: 10 запросов/мин.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set(\"admin_token\", data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Выход администратора",
          "request": {
            "method": "POST",
            "header": [],
