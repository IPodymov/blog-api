        {
          "name": "Создать статью от имени пользователя",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/v1/sites/{{site_key}}/articles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "v1",
                "sites",
                "{{site_key}}",
                "articles"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "author_id — любой пользователь этого сайта, независимо от роли.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author_id\": 2,\n  \"title\": \"Первый пост\",\n  \"slug\": \"first-post\",\n  \"description\": \"Краткое описание\",\n  \"content\": \"# Привет\",\n  \"tags\": [\n    \"health\"\n  ],\n  \"status\": \"published\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const article = pm.response.json();",
                  "  pm.environment.set(\"article_id\", String(article.id));",
                  "  pm.environment.set(\"slug\", article.slug);",
                  "  const etag = pm.response.headers.get(\"ETag\");",
                  "  if (etag) pm.environment.set(\"etag\", etag);",
                  "  else pm.environment.unset(\"etag\");",
                  "}"
                ]
              }
            }
          ]
        },
