        {
          "name": "Создать статью",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/articles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "articles"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Только роли author и admin; остальные получают 403 с кодом author_role_required.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Первый пост\",\n  \"slug\": \"first-post\",\n  \"description\": \"Краткое описание\",\n  \"content\": \"# Привет\\nМой первый пост.\",\n  \"tags\": [],\n  \"status\": \"draft\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const article = pm.response.json();",
                  "  pm.environment.set(\"article_id\", String(article.id));",
                  "  pm.environment.set(\"slug\", article.slug);",
                  "  const etag = pm.response.headers.get(\"ETag\");",
                  "  if (etag) pm.environment.set(\"etag\", etag);",
                  "  else pm.environment.unset(\"etag\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить статью",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/articles/{{article_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "articles",
                "{{article_id}}"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "GET не регистрирует просмотр. По ID: черновик доступен автору и администратору. По slug: только опубликованная статья. canonical_url строится из public_url сайта (если пуст — PUBLIC_SITE_URL) + /articles/{slug}; у черновика null."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const article = pm.response.json();",
                  "  pm.environment.set(\"article_id\", String(article.id));",
                  "  pm.environment.set(\"slug\", article.slug);",
                  "  const etag = pm.response.headers.get(\"ETag\");",
                  "  if (etag) pm.environment.set(\"etag\", etag);",
                  "  else pm.environment.unset(\"etag\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Изменить статью",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              },
              {
                "key": "If-Match",
                "value": "{{etag}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/articles/{{article_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "articles",
                "{{article_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Автор статьи с ролью author либо администратор. Проверка версии атомарна. Снятие публикации сохраняет просмотры, лайки и комментарии для личной аналитики; из публичной статистики статья исчезает.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Первый пост\",\n  \"slug\": \"first-post\",\n  \"description\": \"Краткое описание\",\n  \"content\": \"# Привет\\nМой первый пост.\",\n  \"tags\": [],\n  \"status\": \"draft\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const article = pm.response.json();",
                  "  pm.environment.set(\"article_id\", String(article.id));",
                  "  pm.environment.set(\"slug\", article.slug);",
                  "  const etag = pm.response.headers.get(\"ETag\");",
                  "  if (etag) pm.environment.set(\"etag\", etag);",
                  "  else pm.environment.unset(\"etag\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Удалить статью",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              },
              {
                "key": "If-Match",
