  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Регистрация пользователя",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Роль user; с invite_token — роль из приглашения глобального администратора (неверный, использованный, истёкший или чужой токен — 422). Возвращает токены только в этом приватном ответе. Rate limit всех auth: 10 запросов/мин на сетевой адрес.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set(\"access_token\", data.access_token);",
                  "  pm.environment.set(\"refresh_token\", data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Вход",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set(\"access_token\", data.access_token);",
                  "  pm.environment.set(\"refresh_token\", data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Ротация refresh-токена",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Одноразовая ротация. Повторное использование использованного токена отзывает всё семейство, включая access-токены. Одновременные refresh-запросы клиент должен сериализовать. Абсолютный срок семейства не продлевается.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set(\"access_token\", data.access_token);",
                  "  pm.environment.set(\"refresh_token\", data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Выход и отзыв семейства",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Идемпотентно, включая неизвестный токен корректного формата. Отзывает также все access-токены семейства.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.environment.unset(\"access_token\");",
                  "  pm.environment.unset(\"refresh_token\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Проверить приглашение",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/invites/{{token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "invites",
                "{{token}}"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Для страницы регистрации: показывает роль и email приглашения, пока оно действует. Использованное, истёкшее, отозванное или чужого сайта — 404."
          }
        }
      ]
