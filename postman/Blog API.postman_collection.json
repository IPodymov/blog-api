        {
          "name": "Получить статью",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Site-Key",
                "value": "{{site_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/articles-by-slug/{{slug}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "articles-by-slug",
                "{{slug}}"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "GET не регистрирует просмотр. По ID: черновик доступен автору и администратору. По slug: только опубликованная статья. canonical_url строится из public_url сайта (если пуст — PUBLIC_SITE_URL) + /articles/{slug}; у черновика null."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const article = pm.response.json();",
                  "  pm.environment.set(\"article_id\", String(article.id));",
                  "  pm.environment.set(\"slug\", article.slug);",
                  "  const etag = pm.response.headers.get(\"ETag\");",
                  "  if (etag) pm.environment.set(\"etag\", etag);",
                  "  else pm.environment.unset(\"etag\");",
                  "}"
                ]
              }
            }
          ]
        }
      ]
